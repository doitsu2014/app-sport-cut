{
  "schema": "sportcut-c4/1",
  "title": "Sportcut",
  "description": "The C4 model for Sportcut. Elements and declared relationships live here; every diagram under docs/architecture/c4/generated/ is rendered from this file by tools/generate-c4-diagrams.sh. Compile-time edges in the component view are derived from `cargo metadata`, not typed here.",
  "elements": [
    {
      "id": "editor",
      "name": "Editor",
      "type": "person",
      "technology": "Human",
      "description": "Imports a recording, marks the court, confirms rallies and the score, exports a highlight."
    },
    {
      "id": "sportcut",
      "name": "Sportcut",
      "type": "system",
      "technology": "macOS desktop",
      "description": "Turns one badminton recording into a highlight video on this Mac."
    },
    {
      "id": "recordings",
      "name": "Recording files",
      "type": "external",
      "technology": "User-owned files",
      "description": "The recording the user picked. Sportcut copies it into custody and never modifies the original."
    },
    {
      "id": "avfoundation",
      "name": "AVFoundation",
      "type": "external",
      "technology": "macOS framework",
      "description": "Plays the recording and its proxy in the client."
    },
    {
      "id": "note-offline",
      "name": "No network",
      "type": "note",
      "description": "There is no cloud service, telemetry endpoint, or online API on any path. Recordings and analysis stay on this Mac."
    },
    {
      "id": "app",
      "name": "Flutter client",
      "type": "container",
      "technology": "Dart 3 · Riverpod · app/",
      "description": "Library, studio, playback, and the protocol client. Links no Rust."
    },
    {
      "id": "service",
      "name": "SportcutService",
      "type": "container",
      "technology": "Rust · core/adapters/service",
      "description": "Background process. Owns media processing, analysis, jobs, the catalog, and export."
    },
    {
      "id": "state",
      "name": "State root",
      "type": "dataStore",
      "technology": "SQLite + files",
      "description": "Catalog (schema v6 target), recordings, artifacts, run/ and logs/."
    },
    {
      "id": "client-catalog",
      "name": "Client v5 catalog",
      "type": "dataStore",
      "technology": "SQLite · interim",
      "description": "The app's own catalog and recording copy until ADR-0001 Phase 4 retires them."
    },
    {
      "id": "ffmpeg",
      "name": "ffmpeg / ffprobe",
      "type": "external",
      "technology": "Media toolchain · required",
      "description": "Probe, proxy, audio, frames, and export. Required at runtime."
    },
    {
      "id": "tflite",
      "name": "TFLite runtime + model",
      "type": "external",
      "technology": "EfficientDet-Lite0 · optional",
      "description": "Player tracking only. Absent when the build omits macos-tflite-eval."
    },
    {
      "id": "service-host",
      "name": "Service host",
      "type": "component",
      "technology": "sportcut-service · core/adapters/service",
      "description": "Process host: Unix socket, peer UID, single-instance lock, job loop, cancellation.",
      "crate": "sportcut-service"
    },
    {
      "id": "api",
      "name": "Engine facade",
      "type": "component",
      "technology": "sportcut-api · core/adapters/api",
      "description": "The library the host calls. Orchestrates the use cases.",
      "crate": "sportcut-api"
    },
    {
      "id": "protocol",
      "name": "Wire contract",
      "type": "component",
      "technology": "sportcut-protocol · core/gateways/protocol",
      "description": "Method names, DTOs, error codes, framing, version negotiation.",
      "crate": "sportcut-protocol"
    },
    {
      "id": "storage",
      "name": "Storage adapter",
      "type": "component",
      "technology": "sportcut-storage · core/gateways/storage",
      "description": "Catalog, artifacts, recording store. Implements ports declared by the use cases.",
      "crate": "sportcut-storage"
    },
    {
      "id": "jobs",
      "name": "Jobs",
      "type": "component",
      "technology": "sportcut-jobs",
      "description": "Job model, one heavy job at a time, checkpoints, resume.",
      "crate": "sportcut-jobs"
    },
    {
      "id": "media",
      "name": "Media",
      "type": "component",
      "technology": "sportcut-media",
      "description": "Probe, proxy, audio, frames through the media toolchain.",
      "crate": "sportcut-media"
    },
    {
      "id": "vision",
      "name": "Vision",
      "type": "component",
      "technology": "sportcut-vision",
      "description": "Court and player detection; TFLite is optional.",
      "crate": "sportcut-vision"
    },
    {
      "id": "export",
      "name": "Export",
      "type": "component",
      "technology": "sportcut-export",
      "description": "Edit list and render.",
      "crate": "sportcut-export"
    },
    {
      "id": "eval",
      "name": "Evaluation",
      "type": "component",
      "technology": "sportcut-eval",
      "description": "Segmentation and ranking evaluation.",
      "crate": "sportcut-eval"
    },
    {
      "id": "common",
      "name": "Common",
      "type": "component",
      "technology": "sportcut-common",
      "description": "Shared types. Every crate may use it.",
      "crate": "sportcut-common"
    },
    {
      "id": "court",
      "name": "Court",
      "type": "component",
      "technology": "sportcut-court",
      "description": "Homography, validation, net projection.",
      "crate": "sportcut-court"
    },
    {
      "id": "rally",
      "name": "Rally",
      "type": "component",
      "technology": "sportcut-rally",
      "description": "Rally segmentation.",
      "crate": "sportcut-rally"
    },
    {
      "id": "score",
      "name": "Score",
      "type": "component",
      "technology": "sportcut-score",
      "description": "Score and serving rules.",
      "crate": "sportcut-score"
    },
    {
      "id": "highlight",
      "name": "Highlight",
      "type": "component",
      "technology": "sportcut-highlight",
      "description": "Highlight ranking.",
      "crate": "sportcut-highlight"
    },
    {
      "id": "cli",
      "name": "CLI driver",
      "type": "component",
      "technology": "sportcut-cli · core/drivers/cli",
      "description": "Developer entry point. Not shipped in the app.",
      "crate": "sportcut-cli"
    },
    {
      "id": "shell",
      "name": "App shell",
      "type": "component",
      "technology": "app/lib/src/app · di/router",
      "description": "Startup, dependency injection, routing.",
      "path": "app/lib/src/app/di.dart"
    },
    {
      "id": "design",
      "name": "Design system",
      "type": "component",
      "technology": "app/lib/src/app/design",
      "description": "Tokens, metrics, typography, and shared components.",
      "path": "app/lib/src/app/design"
    },
    {
      "id": "sportcut_engine",
      "name": "SportcutEngine",
      "type": "component",
      "technology": "app/lib/src/bridge/sportcut_engine.dart",
      "description": "Typed engine API. The only place the app knows the service exists.",
      "path": "app/lib/src/bridge/sportcut_engine.dart"
    },
    {
      "id": "protocol_client",
      "name": "ServiceConnection",
      "type": "component",
      "technology": "app/lib/src/bridge/protocol_client.dart",
      "description": "Unix socket, framing, request correlation, handshake.",
      "path": "app/lib/src/bridge/protocol_client.dart"
    },
    {
      "id": "models",
      "name": "Models",
      "type": "component",
      "technology": "app/lib/src/bridge/models.dart",
      "description": "Typed DTOs mirrored from the protocol.",
      "path": "app/lib/src/bridge/models.dart"
    },
    {
      "id": "catalog",
      "name": "Client catalog",
      "type": "component",
      "technology": "features/library/data/match_catalog.dart",
      "description": "Interim v5 catalog. Service-owned from ADR-0001 Phase 4.",
      "path": "app/lib/src/features/library/data/match_catalog.dart"
    },
    {
      "id": "f-analysis",
      "name": "analysis",
      "type": "component",
      "technology": "feature",
      "description": "Artifact badges and rebuild state.",
      "path": "app/lib/src/features/analysis"
    },
    {
      "id": "f-calibration",
      "name": "calibration",
      "type": "component",
      "technology": "feature",
      "description": "Mark the court; render the engine's outline and net.",
      "path": "app/lib/src/features/calibration"
    },
    {
      "id": "f-editing",
      "name": "editing",
      "type": "component",
      "technology": "feature",
      "description": "Score timeline and edit-list data.",
      "path": "app/lib/src/features/editing"
    },
    {
      "id": "f-export",
      "name": "export",
      "type": "component",
      "technology": "feature",
      "description": "Export settings and start.",
      "path": "app/lib/src/features/export"
    },
    {
      "id": "f-highlights",
      "name": "highlights",
      "type": "component",
      "technology": "feature",
      "description": "Ranking and reel assembly.",
      "path": "app/lib/src/features/highlights"
    },
    {
      "id": "f-library",
      "name": "library",
      "type": "component",
      "technology": "feature",
      "description": "Match library, repository, import.",
      "path": "app/lib/src/features/library"
    },
    {
      "id": "f-rally",
      "name": "rally",
      "type": "component",
      "technology": "feature",
      "description": "Rally review and boundaries.",
      "path": "app/lib/src/features/rally"
    },
    {
      "id": "f-score",
      "name": "score",
      "type": "component",
      "technology": "feature",
      "description": "Score entry and serving sides.",
      "path": "app/lib/src/features/score"
    },
    {
      "id": "f-tracking",
      "name": "tracking",
      "type": "component",
      "technology": "feature",
      "description": "Player tracking overlay and panel.",
      "path": "app/lib/src/features/tracking"
    },
    {
      "id": "f-workspace",
      "name": "workspace",
      "type": "component",
      "technology": "feature",
      "description": "Studio shell, stage strip, playback.",
      "path": "app/lib/src/features/workspace"
    }
  ],
