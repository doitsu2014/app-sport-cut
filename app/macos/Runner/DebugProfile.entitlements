<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Development only.

	  The macOS runner is unsandboxed while developing because the engine is
	  loaded from core/crates/api/target/release and the analysis pipeline runs
	  the local ffmpeg on the user's own recording. Both are outside the app
	  container, so a sandbox blocks them:

	    dlopen(.../libsportcut_api.dylib) (file system sandbox blocked open())

	  Release.entitlements keeps the sandbox on. macOS is not a shipping target
	  for this project (see the design's non-goals); this runner exists so the
	  app can be developed and reviewed on a workstation.
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!--
	  Required by the file picker's macOS implementation, which refuses to open
	  NSOpenPanel unless the app is signed with this entitlement. It checks the
	  entitlement itself rather than the sandbox, so an unsandboxed development
	  build needs it too — without it, choosing a recording fails with
	  "Either the Read-Only or Read-Write entitlement is required for this
	  action." Read-only is enough: the recording is read and copied into
	  app-owned storage, never modified.
	-->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
